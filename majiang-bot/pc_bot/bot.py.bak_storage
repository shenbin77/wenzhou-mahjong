# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
def setup_logger():
    log_dir = Path(CONFIG["log_dir"])
    log_dir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    log_file = log_dir / f"bot_{ts}.log"

    logger = logging.getLogger("majong_bot")
    logger.setLevel(logging.INFO)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s")

    fh = logging.FileHandler(log_file, encoding="utf-8")
    fh.setFormatter(fmt)
    ch = logging.StreamHandler(sys.stdout)
    ch.setFormatter(fmt)
    logger.addHandler(fh)
    logger.addHandler(ch)
    logger.info(f"日志文件: {log_file}")
    return logger, log_dir


LOG, LOG_DIR = setup_logger()


def save_error_shot(png_bytes, tag="err"):
    """异常时把当时的截图存下来，方便复盘。"""
    try:
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        p = LOG_DIR / f"{tag}_{ts}.png"
        p.write_bytes(png_bytes)
        LOG.info(f"已保存异常截图: {p}")
    except Exception as e:
        LOG.warning(f"保存异常截图失败: {e}")


# ---------------------------------------------------------------------------
# ADB 封装（直连模拟器，不经过 pc-server，少一跳更稳）
# ---------------------------------------------------------------------------
class ADB:
    def __init__(self, serial=None, adb_path=None):
        self.serial = serial or CONFIG["adb_serial"]
        self.adb = adb_path or CONFIG["adb_path"]

    def _run(self, args, timeout):
        cmd = [self.adb, "-s", self.serial] + args
        return subprocess.run(cmd, capture_output=True, timeout=timeout)

    def check_connection(self):
        """adb devices 里能不能看到模拟器。"""
        try:
            r = self._run(["devices"], timeout=10)
            out = r.stdout.decode(errors="ignore")
            ok = self.serial in out and "device" in out
            return ok, out.strip()
        except FileNotFoundError:
            return False, "找不到 adb，可执行文件不在 PATH"
        except Exception as e:
            return False, str(e)

    def screencap(self, retries=3):
        """截图，返回 PNG bytes。失败重试，3 次都失败抛异常。"""
        last_err = None
        for i in range(retries):
            try:
                r = self._run(["exec-out", "screencap", "-p"],
                              timeout=CONFIG["shot_timeout"])
                if r.returncode == 0 and len(r.stdout) > 50000:
                    return r.stdout
                last_err = f"returncode={r.returncode} len={len(r.stdout)}"
            except Exception as e:
                last_err = str(e)
            LOG.warning(f"截图失败 ({i + 1}/{retries}): {last_err}")
            time.sleep(1)
        raise RuntimeError(f"截图连续失败 {retries} 次: {last_err}")

    def tap(self, x, y):
        """点一下 (x, y)。"""
        r = self._run(["shell", "input", "tap", str(int(x)), str(int(y))],
                      timeout=CONFIG["tap_timeout"])
        if r.returncode != 0:
            raise RuntimeError(f"tap 失败: {r.stderr.decode(errors='ignore')[:200]}")


def decode_png(png_bytes):
    arr = np.frombuffer(png_bytes, dtype=np.uint8)
    img = cv2.imdecode(arr, cv2.IMREAD_COLOR)
    if img is None:
        raise RuntimeError("PNG 解码失败")
    return img


# ---------------------------------------------------------------------------
# 识牌
# ---------------------------------------------------------------------------
class NoTemplatesError(Exception):
    """新皮肤模板还没裁，识牌不可用。"""


class TileRecognizer:
    """
    牌面识别。

    - count_tiles(): 数手牌有几张（轮廓法，不依赖模板，换皮肤也行）。
      用途：判断"是不是轮到我出牌"（张数变多 = 刚摸牌）。
    - recognize_hand(): 认出每张是什么牌（模板匹配，需要 templates_new/）。
      模板没备齐就抛 NoTemplatesError，上层按 CONFIG 兜底。
    """

    def __init__(self, template_dir=None):
        self.template_dir = Path(template_dir or CONFIG["template_dir"])
        self.templates = []  # [(name, tile_id, img_gray)]
        self._loaded = False

    def load_templates(self):
        if self._loaded:
            return
        if not self.template_dir.is_dir():
            raise NoTemplatesError(f"模板目录不存在: {self.template_dir}")
        for p in sorted(self.template_dir.glob("*.png")):
            tid = TEMPLATE_NAME_TO_ID.get(p.stem.lower())
            if tid is None:
                LOG.warning(f"模板文件名无法识别，已跳过: {p.name}")
                continue
            img = cv2.imread(str(p), cv2.IMREAD_GRAYSCALE)
            if img is None:
                LOG.warning(f"模板读不出来，已跳过: {p.name}")
                continue
            self.templates.append((p.stem, tid, img))
        self._loaded = True
        if not self.templates:
            raise NoTemplatesError(f"{self.template_dir} 里没有可用模板")
        LOG.info(f"载入 {len(self.templates)} 张牌模板")

    def count_tiles(self, img_bgr, roi=None):
        """数手牌区有几张牌。返回 (张数, [bboxes])。"""
        x0, y0, x1, y1 = roi or CONFIG["hand_roi"]
        crop = img_bgr[y0:y1, x0:x1]
        gray = cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY)
        gray = cv2.GaussianBlur(gray, (5, 5), 0)
        # 牌面接近白色，背景是深绿，二值化能分开
        _, th = cv2.threshold(gray, 180, 255, cv2.THRESH_BINARY)
        contours, _ = cv2.findContours(th, cv2.RETR_EXTERNAL,
                                       cv2.CHAIN_APPROX_SIMPLE)
        boxes = []
        for c in contours:
            area = cv2.contourArea(c)
            if not (CONFIG["count_min_area"] <= area <= CONFIG["count_max_area"]):
                continue
            bx, by, bw, bh = cv2.boundingRect(c)
            if bh == 0:
                continue
            aspect = bw / bh
            if not (CONFIG["count_min_aspect"] <= aspect <= CONFIG["count_max_aspect"]):
                continue
            boxes.append((bx + x0, by + y0, bx + x0 + bw, by + y0 + bh))
        boxes.sort(key=lambda b: b[0])
        # 只合并真正重叠的框（同一张牌被切成两块）。
        # 注意：相邻牌之间只有 2-5px 缝隙，绝不能按距离合并，否则 14 张会被并成 3 组。
        # 另过滤左边缘伪影（x<150 的不完整牌/UI 残留）。
        merged = []
        for b in boxes:
            if b[0] < 150:
                continue
            if merged and b[0] < merged[-1][2]:
                m = merged[-1]
                merged[-1] = (m[0], min(m[1], b[1]), max(m[2], b[2]),
                              max(m[3], b[3]))
            else:
                merged.append(b)
        return len(merged), merged

    def recognize_hand(self, img_bgr, roi=None):
        """
        认出每张牌。返回 [(tile_id, x1, y1, x2, y2)]，按从左到右排。
        模板缺失 -> NoTemplatesError。
        """
        self.load_templates()  # 没模板这里就抛
        x0, y0, x1, y1 = roi or CONFIG["hand_roi"]
        crop = img_bgr[y0:y1, x0:x1]
        gray = cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY)

        hits = []  # (score, tile_id, cx, cy, w, h)
        for name, tid, tmpl in self.templates:
            th, tw = tmpl.shape
            for scale in CONFIG["match_scales"]:
                w, h = int(tw * scale), int(th * scale)
                if w < 10 or h < 10 or w > crop.shape[1] or h > crop.shape[0]:
                    continue
                rs = cv2.resize(tmpl, (w, h), interpolation=cv2.INTER_AREA)
                res = cv2.matchTemplate(gray, rs, cv2.TM_CCOEFF_NORMED)
                ys, xs = np.where(res >= CONFIG["match_threshold"])
                for px, py in zip(xs, ys):
                    hits.append((float(res[py, px]), tid,
                                 px + x0 + w / 2, py + y0 + h / 2, w, h))
        # 非极大抑制：按分数从高到低，中心点太近的只留最高分
        hits.sort(key=lambda h: -h[0])
        kept = []
        for score, tid, cx, cy, w, h in hits:
            if all(abs(cx - k[2]) > w * 0.6 or abs(cy - k[3]) > h * 0.6
                   for k in kept):
                kept.append((score, tid, cx, cy, w, h))
        kept.sort(key=lambda k: k[2])  # 按 x 从左到右
        # Sanity: 每种牌最多 4 张，超出的按分数从低到高丢掉（防模板误报）
        from collections import Counter
        _cnt = Counter(k[1] for k in kept)
        _over = {tid for tid, c in _cnt.items() if c > 4}
        if _over:
            _filtered = []
            _seen = Counter()
            # kept 已按分数从高到低排过？没有，这里按分数重排再取前4
            _by_score = sorted(kept, key=lambda k: -k[0])
            for k in _by_score:
                tid = k[1]
                if tid in _over and _seen[tid] >= 4:
                    continue
                _seen[tid] += 1
                _filtered.append(k)
            kept = sorted(_filtered, key=lambda k: k[2])
            LOG.warning(f"识别到超4张的牌已过滤: {_over}")
        result = [(tid, int(cx - w / 2), int(cy - h / 2),
                   int(cx + w / 2), int(cy + h / 2))
                  for _, tid, cx, cy, w, h in kept]
        LOG.info("识牌: " + " ".join(tile_name(t) for t, *_ in result))
        return result


# ---------------------------------------------------------------------------
# 对局状态（尽量用"张数变化"这种不依赖模板的信号）
# ---------------------------------------------------------------------------
class GameState:
    def __init__(self):
        self.last_count = 0
        self.rounds_started = 0
        self.rounds_done = 0
        self.turn_no = 1
        self.round_start_time = 0
        self.jiabei_clicked = False
        self._same_count_streak = 0
        self._last_click_xy = None

    def maybe_tuoguan(self, img_bgr):
        """
        实验性：检测"正在托管" overlay（中央青色机器人图标）。
        误报了也无妨——只是多点一下屏幕中央。
        """
        if not CONFIG["tuoguan_check"]:
            return False
        try:
            h, w = img_bgr.shape[:2]
            cx0, cx1 = int(w * 0.35), int(w * 0.65)
            cy0, cy1 = int(h * 0.35), int(h * 0.65)
            crop = img_bgr[cy0:cy1, cx0:cx1]
            hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
            # 青色：H~85-95
            mask = cv2.inRange(hsv, np.array([80, 100, 100]),
                               np.array([100, 255, 255]))
            n = int(cv2.countNonZero(mask))
            return n > CONFIG["tuoguan_cyan_pixels"]
        except Exception:
            return False

    def update(self, count):
        """
        每轮喂入手牌张数，返回 (事件, 是否轮到我)。
        事件: "round_start" / "round_end" / None
        """
        event = None
        my_turn = False
        if self.last_count < 5 and count >= 12:
            # 手牌从无到有：新的一局开始了
            # （bot 中途启动也可能误触发，无害：不加倍盲点已删，只记日志）
            event = "round_start"
            self.rounds_started += 1
            self.turn_no = 1
            self.round_start_time = time.time()
            self.jiabei_clicked = False
        elif self.last_count >= 12 and count == 0:
            # 手牌突然清空：结算了
            event = "round_end"
            self.rounds_done += 1
        elif count > self.last_count and count >= 12:
            # 张数变多：刚摸了一张，轮到我出牌
            my_turn = True
        elif count >= 14 and self.last_count >= 14:
            # 兜底：连续两轮都看到 14+ 张（漏掉了递增的那一拍），补打
            # 防无限循环：如果连续 5 次都是 14 张，说明点击没生效，停下来报错
            self._same_count_streak = getattr(self, '_same_count_streak', 0) + 1
            if self._same_count_streak >= 5:
                LOG.error(f"连续 {self._same_count_streak} 轮 14 张，点击疑似无效，停止兜底防止死循环")
                my_turn = False
            else:
                LOG.warning(f"张数持续 {count}（上轮 {self.last_count}），兜底出牌 (连续{self._same_count_streak}次)")
                my_turn = True
        if count != self.last_count:
            self._same_count_streak = 0
        self.last_count = count
        return event, my_turn


# ---------------------------------------------------------------------------
# Brain：Advisor + 字牌 heuristic
# ---------------------------------------------------------------------------
class Brain:
    """
    出牌决策。

    优先规则（按顺序）:
    1. 花牌（70）：直接出（ bonus 牌，留手里没用）。
    2. 财神（55）：永远不出（除非整手只剩财神这种不可能的情况）。
    3. 孤张字牌：按  北>西>南>东>白>發>中 的顺序出。
       （字牌不能组顺子，孤张价值最低；三元牌稍微留一手。）
    4. 其余：走 Advisor（效率分 - λ*危险度），跳过字牌对子/刻子。
    5. 兜底：Advisor 挂了就打最左边的非财神牌。

    TODO: shanten 引擎是 112 张版本，字牌只当"不能组顺子"处理，
    没有番种层面的字牌价值模型。等新手场规则确认后升级。
    """
    HONOR_DISCARD_PRIO = {64: 0, 63: 1, 62: 2, 61: 3, 67: 4, 66: 5, 65: 6}

    def __init__(self):
        self.advisor = None
        if ENGINE_OK:
            try:
                self.advisor = Advisor()  # 纯本地，不连阿法
                LOG.info("Brain: Advisor 本地引擎加载成功")
            except Exception as e:
                LOG.warning(f"Brain: Advisor 初始化失败，降级为 heuristic: {e}")
        else:
            LOG.warning(f"Brain: engine 导入失败 {ENGINE_IMPORT_ERROR}，纯 heuristic 模式")

    def decide(self, hand):
        """
        hand: [tile_id...]，14 张左右（含刚摸的）。
        返回: 要打出的 tile_id。
        """
        hand = [int(t) for t in hand]
        counts = Counter(hand)

        # 0. 张数不对（比如 16 张带花）：先清花牌
        if FLOWER_ID in hand:
            return FLOWER_ID

        # 1. 孤张字牌优先出
        lone_honors = [t for t in hand
                       if t in HONOR_IDS and counts[t] == 1]
        if lone_honors:
            lone_honors.sort(key=lambda t: self.HONOR_DISCARD_PRIO.get(t, 99))
            LOG.info(f"Brain: 孤张字牌 -> {tile_name(lone_honors[0])}")
            return lone_honors[0]

        # 2. Advisor（跳过财神和字牌对子/刻子）
        if self.advisor is not None and len(hand) in (13, 14):
            try:
                advice = self.advisor.advise(hand, {}, 1)
                for opt in advice.get("options", []):
                    t = int(opt["tile"])
                    if t == WILD_ID:
                        continue
                    if t in HONOR_IDS and counts[t] >= 2:
                        continue  # 字牌对子/刻子留着
                    LOG.info(
                        f"Brain: {tile_name(t)} "
                        f"(向听{opt.get('shanten_after')} "
                        f"危险{opt.get('danger')} "
                        f"综合{opt.get('final_score')})"
                    )
                    return t
            except Exception as e:
                LOG.warning(f"Brain: Advisor 异常，降级兜底: {e}")

        # 3. 兜底：最左边非财神、非字牌对子的牌
        for t in sorted(hand):
            if t == WILD_ID:
                continue
            if t in HONOR_IDS and counts[t] >= 2:
                continue
            LOG.info(f"Brain(兜底): {tile_name(t)}")
            return t
        return hand[0]  # 理论上到不了

    def shanten_of(self, hand):
        try:
            return calc_shanten([int(t) for t in hand])
        except Exception:
            return "?"


# ---------------------------------------------------------------------------
# Bot 主循环
# ---------------------------------------------------------------------------
class Bot:
    def __init__(self, dry_run=False):
        self.dry_run = dry_run
        self.adb = ADB()
        self.recognizer = TileRecognizer()
        self.state = GameState()
        self.brain = Brain()
        self.running = True

    # -- 小动作 ------------------------------------------------------------
    def do_tap(self, x, y, why=""):
        if self.dry_run:
            LOG.info(f"[dry-run] 跳过点击 ({x},{y}) {why}")
            return
        self.adb.tap(x, y)
        LOG.info(f"点击 ({x},{y}) {why}")

    def check_action_buttons(self, img):
        """检测碰/杠/胡/过按钮。返回 (action, x, y) 或 None。
        优先级：胡 > 杠 > 碰 > 过。模板缺失则跳过。"""
        x1, y1, x2, y2 = CONFIG["action_btn_roi"]
        roi = img[y1:y2, x1:x2]
        if roi.size == 0:
            return None
        gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        tmpl_dir = Path(CONFIG["template_dir"])
        # 优先级顺序
        for action in ["hu", "gang", "peng", "guo"]:
            fname = CONFIG["action_btn_templates"].get(action)
            if not fname:
                continue
            p = tmpl_dir / fname
            if not p.exists():
                continue
            tmpl = cv2.imread(str(p), cv2.IMREAD_GRAYSCALE)
            if tmpl is None:
                continue
            res = cv2.matchTemplate(gray, tmpl, cv2.TM_CCOEFF_NORMED)
            _, max_val, _, max_loc = cv2.minMaxLoc(res)
            if max_val >= CONFIG["action_btn_threshold"]:
                cx = x1 + max_loc[0] + tmpl.shape[1] // 2
                cy = y1 + max_loc[1] + tmpl.shape[0] // 2
                LOG.info(f"检测到动作按钮 [{action}] 置信度 {max_val:.2f} @ ({cx},{cy})")
                return action, cx, cy
        return None

    def check_xiayiju(self, img):
        """检测结算画面的'下一局'按钮。返回 (x, y) 或 None。"""
        # 下一局按钮 ROI（右下区域）
        x1, y1, x2, y2 = 900, 480, 1350, 900
        roi = img[y1:y2, x1:x2]
        if roi.size == 0:
            return None
        gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        tmpl_path = Path(CONFIG["template_dir"]) / "btn_xiayiju.png"
        if not tmpl_path.exists():
            return None
        tmpl = cv2.imread(str(tmpl_path), cv2.IMREAD_GRAYSCALE)
        if tmpl is None:
            return None
        res = cv2.matchTemplate(gray, tmpl, cv2.TM_CCOEFF_NORMED)
        _, max_val, _, max_loc = cv2.minMaxLoc(res)
        if max_val >= 0.9:
            cx = x1 + max_loc[0] + tmpl.shape[1] // 2
            cy = y1 + max_loc[1] + tmpl.shape[0] // 2
            LOG.info(f"检测到'下一局'按钮 置信度 {max_val:.2f} @ ({cx},{cy})")
            return cx, cy
        return None

    def find_tile_box(self, recognized, tile_id):
        """在识别结果里找第一张 tile_id 的框，返回中心点。"""
        for tid, x1, y1, x2, y2 in recognized:
            if tid == tile_id:
                return (x1 + x2) // 2, (y1 + y2) // 2
        return None

    def tap_tile_by_index(self, boxes, index):
        """兜底：按从左到右第 index 张的框中心点。"""
        if 0 <= index < len(boxes):
            x1, y1, x2, y2 = boxes[index]
            self.do_tap((x1 + x2) // 2, (y1 + y2) // 2, "按序号出牌(兜底)")
            return True
        return False

    # -- 一轮 --------------------------------------------------------------
    def tick(self):
        # 1. 截图
        try:
            png = self.adb.screencap()
        except Exception as e:
            LOG.error(f"截图失败，本轮跳过: {e}")
            return
        try:
            img = decode_png(png)
        except Exception as e:
            LOG.error(f"解码失败，本轮跳过: {e}")
            save_error_shot(png, "decode_err")
            return

        # 2. 托管检测：被托管了就点一下取消
        if self.state.maybe_tuoguan(img):
            LOG.warning("检测到托管，点一下取消")
            self.do_tap(*CONFIG["tap_center"], "取消托管")
            time.sleep(1)
            return

        # 2.5 动作按钮检测（碰/杠/胡）：有人打牌时弹出
        btn = self.check_action_buttons(img)
        if btn:
            action, bx, by = btn
            if action == "hu":
                LOG.info(">>> 胡牌按钮！必点")
                self.do_tap(bx, by, "胡牌")
                time.sleep(2)
                return
            elif action in ("gang", "peng"):
                LOG.info(f">>> {action}按钮，点")
                self.do_tap(bx, by, action)
                time.sleep(2)
                return
            # guo：有胡/杠/碰时不会到这里；单独出现说明无事可做，点过
            elif action == "guo":
                LOG.info("只有'过'按钮，点过")
                self.do_tap(bx, by, "过")
                time.sleep(1)
                return

        # 2.6 下一局按钮检测（结算画面）
        xiayiju = self.check_xiayiju(img)
        if xiayiju:
            bx, by = xiayiju
            LOG.info(">>> 发现'下一局'按钮，点")
            self.do_tap(bx, by, "下一局")
            time.sleep(3)
            return

        # 3. 数手牌（快路径：轮廓计数 ~50ms，不依赖模板）
        #    模板识别只在确定轮到我时才跑（慢路径，见 play_turn）
        try:
            count, boxes = self.recognizer.count_tiles(img)
        except Exception as e:
            LOG.error(f"数牌失败: {e}")
            save_error_shot(png, "count_err")
            return

        event, my_turn = self.state.update(count)
        LOG.info(f"[TICK] count={count} last={self.state.last_count} my_turn={my_turn} event={event}")

        # 4. 开局 / 结算事件
        if event == "round_start":
            LOG.info(f"===== 第 {self.state.rounds_started} 局开始 =====")
            # 注：原"不加倍"盲点已删除。原因：(1) btn 模板不存在，
            # (2) 坐标 (480,640) 未验证，(3) return 会吞掉出牌回合。
            # 如游戏真有加倍对话框且卡住，需先裁按钮模板再启用。

        # 5. 结算
        if event == "round_end":
            LOG.info(f"===== 第 {self.state.rounds_done} 局结束 =====")
            if self.state.rounds_done >= CONFIG["max_rounds"]:
                LOG.info(f"已打满 {CONFIG['max_rounds']} 局，按要求自动停止，不点下一局。")
                self.running = False
                return
            LOG.info("等模板检测点下一局（硬编码已删）")
            time.sleep(3)
            return

        # 6. 轮到我：识牌 -> 决策 -> 出牌
        if my_turn:
            self.play_turn(img, png, count, boxes)

    def play_turn(self, img, png, count, boxes):
        LOG.info(f"--- 第 {self.state.rounds_started} 局第 {self.state.turn_no} 手 "
                 f"(手牌 {count} 张) ---")
        # 6.1 识牌（慢路径：只在轮到我时跑一次模板匹配）
        try:
            recognized = self.recognizer.recognize_hand(img)
        except NoTemplatesError as e:
            LOG.warning(f"识牌不可用: {e}")
            if CONFIG["no_template_fallback"] == "rightmost" and boxes:
                LOG.warning("兜底：打最右边一张（刚摸的）")
                self.tap_tile_by_index(boxes, len(boxes) - 1)
                self.state.turn_no += 1
            else:
                LOG.warning("安全模式：本轮不出牌（等模板备齐）")
            return
        except Exception as e:
            LOG.error(f"识牌异常: {e}")
            save_error_shot(png, "recog_err")
            return

        if not recognized:
            LOG.warning("一张牌都没认出来，本轮跳过")
            save_error_shot(png, "recog_empty")
            return

        hand = [tid for tid, *_ in recognized]
        LOG.info("手牌: " + " ".join(tile_name(t) for t in hand) +
                 f" | 向听: {self.brain.shanten_of(hand)}")

        # 6.2 决策
        try:
            choice = self.brain.decide(hand)
        except Exception:
            LOG.error(f"决策异常:\n{traceback.format_exc()}")
            return
        LOG.info(f"决策: 打 {tile_name(choice)}")
        try:_slog({"type":"decision","round":self.state.rounds_started,"turn":self.state.turn_no,"ts":__import__("time").time(),"discard":int(choice),"shanten":int(self.brain.shanten_of(hand))})
        except:pass

        # 6.3 出牌：优先点识别到的那张牌的位置
        pt = self.find_tile_box(recognized, choice)
        if pt:
            tx, ty = pt
            best = None
            best_dist = float("inf")
            for bx1, by1, bx2, by2 in boxes:
                bcx = (bx1 + bx2) // 2
                d = abs(bcx - tx)
                if d < best_dist:
                    best_dist = d
                    best = ((bx1 + bx2) // 2, (by1 + by2) // 2)
            if best and best_dist < 60:
                LOG.info(f"坐标校准: 模板({tx},{ty}) -> 轮廓{best} (偏差{best_dist}px)")
                pt = best
            self.do_tap(*pt, f"出 {tile_name(choice)}")
        else:
            # 备选：按手牌里第几张来点
            try:
                idx = hand.index(choice)
                if not self.tap_tile_by_index(boxes, idx):
                    LOG.error("按序号也点不到，跳过")
                    return
            except ValueError:
                LOG.error("决策的牌不在识别结果里，跳过")
                return
        self.state.turn_no += 1

    # -- 跑 ----------------------------------------------------------------
    def run(self):
        ok, info = self.adb.check_connection()
        if not ok:
            LOG.error(f"ADB 连不上模拟器 ({self.adb.serial})：{info}")
            LOG.error("先跑: adb connect 127.0.0.1:5555，再 adb devices 确认。")
            return 1
        LOG.info(f"ADB 已连接: {self.adb.serial}")
        # 预热模板（缺模板就提前喊，不等到出牌才发现）
        try:
            self.recognizer.load_templates()
        except NoTemplatesError as e:
            LOG.warning(f"{e} -> 进入安全模式：只观察、不出牌。")
        LOG.info(f"启动主循环，每 {CONFIG['tick_interval']} 秒一轮，"
                 f"打满 {CONFIG['max_rounds']} 局自动停。Ctrl+C 随时停。")
        try:
            while self.running:
                t0 = time.time()
                try:
                    self.tick()
                except Exception:
                    LOG.error(f"tick 未捕获异常:\n{traceback.format_exc()}")
                dt = time.time() - t0
                time.sleep(max(0, CONFIG["tick_interval"] - dt))
        except KeyboardInterrupt:
            LOG.info("用户 Ctrl+C，退出。")
        LOG.info(f"结束：共开始 {self.state.rounds_started} 局，"
                 f"完成 {self.state.rounds_done} 局。")
        return 0


def main():
    ap = argparse.ArgumentParser(description="温州麻将 PC 自动代打 bot")
    ap.add_argument("--once", action="store_true", help="只截一张图，数手牌并尝试识牌，然后退出")
    ap.add_argument("--dry-run", action="store_true", help="全流程跑，但不点屏幕")
    ap.add_argument("--serial", default=None, help="ADB 序列号，默认 127.0.0.1:5555")
    ap.add_argument("--max-rounds", type=int, default=None, help="打几局后停，默认 16")
    args = ap.parse_args()

    if args.serial:
        CONFIG["adb_serial"] = args.serial
    if args.max_rounds:
        CONFIG["max_rounds"] = args.max_rounds

    bot = Bot(dry_run=args.dry_run)

    if args.once:
        ok, info = bot.adb.check_connection()
        print("ADB:", "OK" if ok else "FAIL", info)
        if not ok:
            return 1
        png = bot.adb.screencap()
        img = decode_png(png)
        count, boxes = bot.recognizer.count_tiles(img)
        print(f"手牌张数: {count}")
        try:
            rec = bot.recognizer.recognize_hand(img)
            print("识别:", " ".join(tile_name(t) for t, *_ in rec))
            print("向听:", bot.brain.shanten_of([t for t, *_ in rec]))
        except NoTemplatesError as e:
            print("识牌:", e)
        cv2.imwrite(str(LOG_DIR / "once_test.png"), img)
        print(f"截图已存: {LOG_DIR / 'once_test.png'}")
        return 0

    return bot.run()


if __name__ == "__main__":
    sys.exit(main())
